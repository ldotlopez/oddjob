# Copy to .env; real environment variables win over it.

# openai backend (or set [backends.openai] api_key in config.toml)
OPENAI_API_KEY=

# Backend per task, instead of -b or [tasks] in config.toml
ODDJOB_TRANSCRIBE_BACKEND=whisper
ODDJOB_REWRITE_BACKEND=ollama
ODDJOB_SUMMARIZE_BACKEND=ollama
ODDJOB_EXPAND_BACKEND=ollama
