# Integration test settings. Copy to tests/integration.env (git-ignored) and
# fill in. GLADOS_TEST_* environment variables win over this file.
# Each backend's integration test is skipped while its first setting is empty.

# --- whisper.cpp (whisper_cpp) ---
# Path to a ggml model; enables the test.
GLADOS_TEST_WHISPER_CPP_MODEL=
GLADOS_TEST_WHISPER_CPP_BINARY=whisper-cli
# Optional short speech clip; without it a generated tone is transcribed and
# only a successful run is checked.
GLADOS_TEST_WHISPER_CPP_AUDIO=
# Optional text that must appear in the transcript of the clip (case-insensitive).
GLADOS_TEST_WHISPER_CPP_EXPECT=
# Optional language code (e.g. es); empty means auto-detect.
GLADOS_TEST_WHISPER_CPP_LANGUAGE=

# --- piper (speak) ---
# Path to a voice .onnx (its .json beside it); enables the test.
GLADOS_TEST_PIPER_MODEL=
GLADOS_TEST_PIPER_BINARY=piper

# --- llm CLI ---
# Any model `llm models` lists (its key is llm's own config); enables the test.
GLADOS_TEST_LLM_MODEL=
GLADOS_TEST_LLM_BINARY=llm

# --- ollama ---
# A model already pulled on the server (e.g. llama3.2); enables the test.
GLADOS_TEST_OLLAMA_MODEL=
GLADOS_TEST_OLLAMA_BASE_URL=http://localhost:11434
# Optional secret, sent as `Authorization: Bearer <key>` (ollama.com or an
# authenticating proxy).
GLADOS_TEST_OLLAMA_API_KEY=

# --- openai (or any OpenAI-compatible API) ---
# Secret; enables the test.
GLADOS_TEST_OPENAI_API_KEY=
GLADOS_TEST_OPENAI_MODEL=gpt-4.1-mini
GLADOS_TEST_OPENAI_BASE_URL=https://api.openai.com/v1
